[Unit]
Description=Wait for Airflow secret to become available
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/airflow/airflow.conf
ExecStart=/opt/airflow/scripts/wait-for-password.sh
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target